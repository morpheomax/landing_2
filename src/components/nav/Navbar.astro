---
import { SITE, NAV_ITEMS } from '@/data/consts';
---

<header class="site-header pointer-events-none">
  <nav
    class="site-nav pointer-events-auto flex max-w-6xl items-center justify-between rounded-full border border-mist-100/15 bg-space-950/70 px-5 py-3 shadow-[0_18px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl sm:px-8"
    aria-label="Navegación principal"
  >
    <a href="#inicio" data-cms="site.name" class="font-display text-sm font-semibold tracking-wide text-mist-100 sm:text-base">
      {SITE.name}
    </a>

    <!-- Nav desktop -->
    <ul class="hidden items-center gap-7 md:flex">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            data-nav-link
            href={item.href}
            class="font-mono-label text-[11px] text-mist-100/60 transition-colors duration-300 hover:text-nova-400"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="#contacto"
      class="hidden rounded-full bg-nova-400 px-4 py-2 text-xs font-semibold text-space-950 transition-transform duration-300 hover:scale-105 md:inline-block"
    >
      Reservar
    </a>

    <!-- Botón menú móvil -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="group relative flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border border-mist-100/20 transition-colors duration-300 hover:border-nova-400 md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Menú</span>
      <span class="hamburger-line hamburger-line-top"></span>
      <span class="hamburger-line hamburger-line-middle"></span>
      <span class="hamburger-line hamburger-line-bottom"></span>
    </button>
  </nav>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    class="mobile-menu pointer-events-auto rounded-2xl border border-mist-100/15 bg-space-950/85 shadow-[0_18px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl md:hidden"
    aria-hidden="true"
  >
    <ul class="flex flex-col gap-4 p-5">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            data-nav-link
            href={item.href}
            class="font-mono-label block rounded-lg px-2 py-1 text-xs text-mist-100/80 transition-colors duration-300 hover:bg-mist-100/5 hover:text-nova-400"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style is:global>
  .site-header {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 2147483000 !important;
    isolation: isolate;
  }

  .site-nav {
    margin: 0.75rem 0.75rem 0;
  }

  @media (min-width: 640px) {
    .site-nav {
      margin: 1.25rem 1.25rem 0;
    }
  }

  @media (min-width: 1024px) {
    .site-nav {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hamburger-line {
    position: absolute;
    left: 50%;
    height: 1.5px;
    width: 16px;
    border-radius: 999px;
    background: var(--color-mist-100);
    transform: translateX(-50%);
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease,
      background-color 240ms ease;
  }

  .hamburger-line-top { transform: translate(-50%, -5px); }
  .hamburger-line-middle { transform: translate(-50%, 0); }
  .hamburger-line-bottom { transform: translate(-50%, 5px); }

  #mobile-menu-toggle[data-open='true'] .hamburger-line {
    background: var(--color-nova-400);
  }

  #mobile-menu-toggle[data-open='true'] .hamburger-line-top {
    transform: translate(-50%, 0) rotate(45deg);
  }

  #mobile-menu-toggle[data-open='true'] .hamburger-line-middle {
    opacity: 0;
    transform: translate(-50%, 0) scaleX(0.2);
  }

  #mobile-menu-toggle[data-open='true'] .hamburger-line-bottom {
    transform: translate(-50%, 0) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed !important;
    top: 4.25rem !important;
    left: 0.75rem !important;
    right: 0.75rem !important;
    z-index: 2147483001 !important;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transform: translateY(-10px) scale(0.98);
    transform-origin: top right;
    filter: blur(8px);
    will-change: max-height, opacity, transform, filter;
    transition:
      max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 280ms ease;
  }

  .mobile-menu[data-open='true'] {
    max-height: 420px;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  @media (min-width: 640px) {
    .mobile-menu {
      top: 5rem !important;
      left: 1.25rem !important;
      right: 1.25rem !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-line,
    .mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setMenuOpen = (isOpen: boolean) => {
    toggle?.setAttribute('aria-expanded', String(isOpen));
    toggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    menu?.setAttribute('aria-hidden', String(!isOpen));

    if (isOpen) {
      toggle?.setAttribute('data-open', 'true');
      menu?.setAttribute('data-open', 'true');
    } else {
      toggle?.removeAttribute('data-open');
      menu?.removeAttribute('data-open');
    }
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  // Cierra el menú móvil al elegir una sección
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenuOpen(false);
    });
  });
</script>
