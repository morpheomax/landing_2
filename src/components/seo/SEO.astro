---
// ============================================================================
// SEO.astro — Metadatos para buscadores tradicionales (SEO) y motores
// generativos / IA (GEO: ChatGPT, Perplexity, Gemini, Claude, etc).
//
// Para GEO lo que más ayuda es:
//  - JSON-LD estructurado y correcto (schema.org) que un LLM pueda parsear
//    con confianza para citar datos concretos (nombre, ubicación, precios).
//  - Contenido de texto claro y semántico en el HTML (no solo imágenes).
//  - Un archivo /llms.txt en la raíz del sitio (ya incluido en /public).
// ============================================================================
import { SITE, CONTACT } from '@/data/consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  image = '/og-cover.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Pedro de Atacama',
    addressRegion: 'Antofagasta',
    addressCountry: 'CL',
  },
  areaServed: 'CL',
  sameAs: [CONTACT.instagram, CONTACT.facebook],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="theme-color" content={SITE.themeColor} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="es_CL" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<!-- JSON-LD estructurado (SEO + GEO) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
