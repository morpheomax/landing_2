---
import { toursRealizados } from '@/data/tours';
import { PAST_TOURS_CONTENT } from '@/data/content';
---

<section id="tours-realizados" class="relative px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-6xl">
    <p data-reveal data-cms="pastTours.eyebrow" class="font-mono-label mb-4 text-xs text-teal-400">{PAST_TOURS_CONTENT.eyebrow}</p>
    <h2 data-reveal data-reveal-delay="0.05" class="font-display max-w-xl text-3xl font-semibold text-mist-100 sm:text-4xl">
      <span data-cms="pastTours.title">{PAST_TOURS_CONTENT.title}</span>
    </h2>
    <p data-reveal data-cms="pastTours.description" data-reveal-delay="0.1" class="mt-4 max-w-xl text-mist-400">
      {PAST_TOURS_CONTENT.description}
    </p>

    <!--
      NOTA PARA EDICIÓN: reemplaza este placeholder por imágenes reales usando
      el componente <Image> de astro:assets. Guía completa en el README,
      sección "Reemplazar imágenes por fotos reales".
    -->
    <div id="past-tours-grid" class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {toursRealizados.map((tour, i) => (
        <article data-reveal data-reveal-delay={0.05 * i} class="group overflow-hidden rounded-2xl glass-panel">
          <div class="flex aspect-[4/5] items-center justify-center bg-gradient-to-br from-space-800 via-nebula-500/20 to-space-950">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-mist-100/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 12v3m9-9h-3M6 12H3m14.95-6.95l-2.12 2.12M8.17 15.83l-2.12 2.12m0-13.9l2.12 2.12m9.66 9.66l-2.12-2.12M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
          </div>
          <div class="p-5">
            <p class="font-mono-label text-[10px] text-nebula-400">{tour.fecha} · {tour.participantes} participantes</p>
            <h3 class="font-display mt-2 text-base font-semibold text-mist-100">{tour.nombre}</h3>
            <p class="mt-2 text-xs text-mist-400">{tour.resumen}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
